# Managed by scripts/configure_runpod_credentials.sh.
# Never commit this local control-plane credential or upload it to a Pod.
RUNPOD_API_KEY=

# Managed by scripts/deploy_runpod_network_volume.sh after volume creation.
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_DATACENTER_ID=EU-RO-1

# Managed by scripts/configure_runpod_credentials.sh. These S3 credentials are
# separate from RUNPOD_API_KEY and remain on the local control machine.
RUNPOD_S3_ACCESS_KEY_ID=
RUNPOD_S3_SECRET_ACCESS_KEY=

# Managed by scripts/deploy_runpod_network_volume.sh.
RUNPOD_S3_REGION=EU-RO-1
RUNPOD_S3_ENDPOINT=https://s3api-eu-ro-1.runpod.io/

# Legacy Cloudflare deployment values are preserved during migration but are not
# used by the Cloud Run relay workflow.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_SUBDOMAIN=

# Managed by scripts/configure_tpex_cloud_run_relay.sh. gcloud credentials stay
# in the local gcloud credential store and are never copied into this dotenv.
GCP_PROJECT_ID=
GCP_CLOUD_RUN_REGION=asia-east1
GCP_TPEX_RELAY_SERVICE=stock-forecasting-tpex-relay
GCP_TPEX_RELAY_SECRET=stock-forecasting-tpex-relay-token
TPEX_PROXY_SHARED_SECRET=

# Managed by scripts/deploy_tpex_cloud_run_relay.sh after live verification.
TPEX_PROXY_URL=
RUNPOD_TPEX_PROXY_SECRET_NAME=
