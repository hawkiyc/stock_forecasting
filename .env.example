# Persistent RunPod network-volume root. Do not point this at /workspace.
RUNPOD_VOLUME_ROOT=/runpod-volume
NETWORK_VOLUME_ROOT=/runpod-volume
PROJECT_ROOT=/runpod-volume/ts_multimodal_LLM
DATA_ROOT=/runpod-volume/data
MODEL_ROOT=/runpod-volume/models
CACHE_ROOT=/runpod-volume/cache
SAVED_MODEL_ROOT=/runpod-volume/savedModel
LOG_ROOT=/runpod-volume/logs
# W&B SDK root; W&B writes run files below /runpod-volume/wandb.
WANDB_DIR=/runpod-volume
HF_HOME=/runpod-volume/cache/huggingface
TORCH_HOME=/runpod-volume/cache/torch

# Local control-plane credential. Use a separate key for each project.
# Never commit this value or upload this account-level key to a Pod.
RUNPOD_API_KEY=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_DATACENTER_ID=EU-RO-1

# Local-only S3 credentials for uploading to the network volume without a Pod.
# These are separate from RUNPOD_API_KEY and must never be uploaded.
RUNPOD_S3_ACCESS_KEY_ID=
RUNPOD_S3_SECRET_ACCESS_KEY=
RUNPOD_S3_REGION=EU-RO-1
RUNPOD_S3_ENDPOINT=https://s3api-eu-ro-1.runpod.io/

# Approved RunPod image runtime. PyTorch and CUDA must come from this image.
RUNPOD_IMAGE=runpod/pytorch:1.0.7-cu1281-torch291-ubuntu2404
RUNPOD_PYTHON_BIN=/usr/local/bin/python
RUNPOD_EXPECTED_TORCH_VERSION=2.9.1+cu128
RUNPOD_EXPECTED_CUDA_PREFIX=12.8
RUNPOD_EXPECTED_UBUNTU_VERSION=24.04

# These are RunPod Secret names, not secret values.
# Create the matching secrets in the RunPod console before creating a Pod.
RUNPOD_HF_SECRET_NAME=huggingface_token
RUNPOD_WANDB_SECRET_NAME=wandb_api_key
RUNPOD_EODHD_SECRET_NAME=eodhd_api_token

# Non-secret W&B routing settings.
WANDB_ENTITY=
WANDB_PROJECT=fin-ts-quant

# Lifecycle controls
RUNPOD_CONFIG=configs/stage1_kronos_base_lora.yaml
MAX_RUNTIME_SECONDS=21600
RUNPOD_HARD_LIMIT_SECONDS=25200
RUNPOD_TERMINATE_AFTER=7h

# Short-lived CPU preparation Pod limits. CPU and GPU use the same fixed image.
RUNPOD_CPU_MAX_RUNTIME_SECONDS=28800
RUNPOD_CPU_HARD_LIMIT_SECONDS=32400
# CPU Pod resource request for parallel Hugging Face model prefetch.
# cpu3g with 8 vCPUs targets the high-memory general-purpose 32GB class.
RUNPOD_API_BASE_URL=https://rest.runpod.io/v1
RUNPOD_CPU_FLAVOR_ID=cpu3g
RUNPOD_CPU_VCPU_COUNT=8

# Offline OHLCV acquisition profile. Empty US symbol lists discover all active
# and delisted US stocks/ETFs available to the EODHD account.
FIN_TS_DATASET_PROFILE=us_tw_eodhd
STAGE1_US_SYMBOLS=
STAGE1_US_ETF_SYMBOLS=
STAGE1_SYMBOL_LIMIT=
STAGE1_DATA_START=2010-01-01
STAGE1_DATA_END=2026-07-27
STAGE1_MAX_API_CALLS=90000
STAGE1_EODHD_QPS=5
STAGE1_TAIWAN_QPS=0.5
